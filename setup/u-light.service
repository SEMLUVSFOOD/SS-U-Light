# Template — setup/install.sh fills in @USER@ and @REPO@.
[Unit]
Description=U-Light phone bridge (Flask dashboard + rpitx OOK)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
Environment=ULIGHT_MOCK=0
Environment=ULIGHT_PORT=8080
Environment=ULIGHT_TX_LOG=@REPO@/web/tx_log.jsonl
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m web.app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
